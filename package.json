{
  "name": "inventory-management",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test --watch=false",
    "lint": "eslint .",
    "e2e": "playwright test",
    "e2e:integration": "npm exec --yes --package firebase-tools@15.36.0 -- firebase emulators:exec --config firebase.e2e.json --project demo-inventory-upgrade --only auth,firestore \"playwright test --config playwright.integration.config.ts\"",
    "build:release": "ng build --configuration production",
    "verify": "npm run lint && npm test && npm run build"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "22.2.6",
    "@angular/common": "22.2.6",
    "@angular/compiler": "22.2.6",
    "@angular/core": "22.2.6",
    "@angular/forms": "22.2.6",
    "@angular/platform-browser": "22.2.6",
    "@angular/router": "22.2.6",
    "@materializecss/materialize": "2.4.0",
    "firebase": "13.3.0",
    "html2canvas": "1.4.1",
    "jspdf": "4.2.1",
    "rxjs": "7.8.2",
    "tslib": "2.9.1",
    "zone.js": "0.16.3",
    "ag-grid-angular": "36.3.0",
    "ag-grid-community": "36.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/compiler-cli": "22.2.6",
    "@angular/language-service": "22.2.6",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "angular-eslint": "22.6.0",
    "eslint": "10.14.0",
    "jsdom": "31.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || ^26.0.0",
    "npm": ">=10"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.14.7"
    },
    "eslint": {
      "minimatch": "11.0.8"
    },
    "@eslint/config-array": {
      "minimatch": "11.0.8"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    }
  }
}
