{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "module": "preserve",
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "useDefineForClassFields": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "src/*": [
        "./src/*"
      ],
      "@materializecss/materialize": [
        "./node_modules/@materializecss/materialize/dist/js/materialize.d.ts"
      ]
    },
    "lib": [
      "ES2022",
      "dom"
    ],
    "strict": false
  },
  "angularCompilerOptions": {
    "strictInjectionParameters": true
  }
}
